## Level 3: 控制流测试

### FOR-EACH 循环
[
  {
    "id": "FOREACH-001",
    "query": "查一下茅台、五粮液、泸州老窖这三只股票的当前股价",
    "expected_control_flow": "for_each",
    "items": ["600519", "000858", "000568"],
    "expected_tools": ["get_quote"],
    "parallel": true,
    "complexity": "medium",
    "evaluation_criteria": "并行查询3只股票，返回各自价格"
  },
  {
    "id": "FOREACH-002",
    "query": "对比一下白酒、银行、医药这三个行业的估值水平",
    "expected_control_flow": "for_each",
    "items": ["白酒", "银行", "医药"],
    "expected_tools": ["get_industry_performance", "compare_industry_valuation"],
    "parallel": true,
    "complexity": "medium",
    "evaluation_criteria": "返回3个行业的PE/PB对比"
  },
  {
    "id": "FOREACH-003",
    "query": "分析一下茅台、五粮液、山西汾酒的财务指标",
    "expected_control_flow": "for_each",
    "items": ["600519", "000858", "600809"],
    "expected_tools": ["calculate_financial_ratios"],
    "parallel": true,
    "complexity": "medium",
    "evaluation_criteria": "返回3只白酒股的ROE、毛利率对比"
  }
]

