## Level 4: 复杂场景 (组合控制流)

[
  {
    "id": "COMPLEX-001",
    "query": "找出最近一周涨幅超过5%的行业，分析这些行业的龙头股",
    "expected_control_flow": "for_each + filter + sequential",
    "steps": [
      "1. get_industry_performance (获取所有行业)",
      "2. FILTER change > 5% (筛选热门行业)",
      "3. FOR-EACH get_industry_leaders (分析龙头)"
    ],
    "complexity": "high",
    "evaluation_criteria": "组合控制流正确执行"
  },
  {
    "id": "COMPLEX-002",
    "query": "选3只低估值银行股，分别分析它们的财务状况",
    "expected_control_flow": "while + for_each",
    "steps": [
      "1. WHILE 找到3只PE<10的银行股",
      "2. FOR-EACH calculate_financial_ratios (分析每只)"
    ],
    "complexity": "high",
    "evaluation_criteria": "嵌套循环正确执行"
  },
  {
    "id": "COMPLEX-003",
    "query": "根据茅台的估值水平决定分析深度：低估值深度分析，否则简单分析，最后给出投资建议",
    "expected_control_flow": "if_else + sequential",
    "steps": [
      "1. get_daily_basic (获取PE)",
      "2. IF-ELSE 选择分析深度",
      "3. assess_stock_risk (风险评估)",
      "4. 生成投资建议"
    ],
    "complexity": "high",
    "evaluation_criteria": "条件分支+顺序执行正确"
  }
]

