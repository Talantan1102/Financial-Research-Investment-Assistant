ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/run-control/backend

WORKDIR /opt/run-control

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" \
    "SQLAlchemy>=2.0" "bcrypt>=4" "psycopg[binary]>=3.1" \
    "psycopg2-binary>=2.9" "pydantic>=2.7" "python-jose>=3.3" "redis>=7.4"

COPY backend/app backend/app
COPY backend/tests/__init__.py backend/tests/__init__.py
COPY backend/tests/helpers backend/tests/helpers
