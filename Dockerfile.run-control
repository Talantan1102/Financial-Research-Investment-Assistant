# Override only for an explicitly trusted registry mirror; the default pins the
# official multi-platform manifest digest rather than a mutable tag.
ARG PYTHON_IMAGE=python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/run-control/backend \
    PATH=/opt/run-control/.venv/bin:$PATH

WORKDIR /opt/run-control
ARG UV_VERSION=0.8.15
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV UV_HTTP_TIMEOUT=120 \
    UV_INDEX_URL=${PIP_INDEX_URL}
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" "uv==${UV_VERSION}"

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --only-group run-control --no-install-project
COPY backend/app backend/app

RUN addgroup --system runcontrol && adduser --system --ingroup runcontrol runcontrol \
    && chown -R runcontrol:runcontrol /opt/run-control
USER runcontrol
