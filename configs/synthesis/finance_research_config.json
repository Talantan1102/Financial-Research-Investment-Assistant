{
  "model_name": "openai/gpt-4o",
  "api_key": "${OPENROUTER_API_KEY}",
  "base_url": "https://openrouter.ai/api/v1",

  "max_depth": 15,
  "branching_factor": 3,
  "depth_threshold": 2,

  "min_depth": 3,
  "max_selected_traj": 3,
  "path_similarity_threshold": 0.7,

  "number_of_seed": null,

  "resource_types": ["finance_research"],
  "resource_init_configs": {
    "finance_research": {
      "content": {
        "kb_name": "${RAG_KB_NAME:-default}"
      }
    }
  },

  "sandbox_server_url": "http://127.0.0.1:18890",
  "sandbox_auto_start": true,
  "sandbox_config_path": "configs/sandbox-server/finance_research_config.json",
  "sandbox_timeout": 120,

  "available_tools": [
    "finance_research:web_search",
    "finance_research:knowledge_search",
    "finance_research:text2sql",
    "finance_research:data_analyzer",
    "finance_research:chart_generator",
    "finance_research:stock_query",
    "finance_research:bidding_search",
    "finance_research:finish"
  ],

  "seed_description": "研究主题或问题",

  "sampling_tips": [
    "使用 web_search 获取最新行业新闻和市场动态",
    "使用 knowledge_search 查询研报和公告等历史资料",
    "使用 stock_query 查询相关公司股价和基本面信息",
    "使用 bidding_search 搜索招投标信息了解市场机会",
    "使用 text2sql 查询结构化财务数据",
    "使用 data_analyzer 分析收集的数据提取洞察",
    "使用 chart_generator 生成可视化图表",
    "多轮搜索，逐步深入，直到信息充分",
    "结合网络搜索和知识库搜索，交叉验证信息",
    "关注数据的时效性和来源可靠性"
  ],

  "synthesis_tips": [
    "生成与金融研究相关的问题",
    "问题应该需要多工具协作才能回答",
    "答案要有具体数据支撑",
    "包含明确的分析结论和建议",
    "问题难度适中，需要3-5个工具调用"
  ],

  "qa_examples": [
    {
      "question": "分析平安银行2024年的业绩表现，包括营收、净利润增长情况，并与同行业对比",
      "answer": "根据查询，平安银行2024年营收同比增长3.5%，净利润增长2.1%，低于行业平均的5.2%和4.8%。主要受净息差收窄影响..."
    }
  ],

  "seeds_file": "seeds/finance_research/seeds.jsonl",
  "output_dir": "results/finance_research"
}
