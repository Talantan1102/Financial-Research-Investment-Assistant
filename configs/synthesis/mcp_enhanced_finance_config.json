{
  "model_name": "openai/gpt-4o",
  "api_key": "${OPENROUTER_API_KEY}",
  "base_url": "https://openrouter.ai/api/v1",

  "max_depth": 15,
  "branching_factor": 3,
  "depth_threshold": 2,

  "min_depth": 3,
  "max_selected_traj": 3,
  "path_similarity_threshold": 0.7,

  "number_of_seed": null,

  "resource_types": ["mcp_enhanced_finance"],
  "resource_init_configs": {
    "mcp_enhanced_finance": {
      "content": {
        "kb_name": "${RAG_KB_NAME:-default}"
      }
    }
  },

  "sandbox_server_url": "http://127.0.0.1:18890",
  "sandbox_auto_start": true,
  "sandbox_config_path": "configs/sandbox-server/mcp_enhanced_finance_config.json",
  "sandbox_timeout": 120,

  "available_tools": [
    "mcp_enhanced_finance:web_search",
    "mcp_enhanced_finance:knowledge_search",
    "mcp_enhanced_finance:text2sql",
    "mcp_enhanced_finance:data_analyzer",
    "mcp_enhanced_finance:chart_generator",
    "mcp_enhanced_finance:stock_query",
    "mcp_enhanced_finance:bidding_search",
    "mcp_enhanced_finance:market_data_get_quote",
    "mcp_enhanced_finance:market_data_search_stock",
    "mcp_enhanced_finance:market_data_get_history",
    "mcp_enhanced_finance:market_data_get_financial_data",
    "mcp_enhanced_finance:financial_analysis_get_financial_report",
    "mcp_enhanced_finance:financial_analysis_calculate_financial_ratios",
    "mcp_enhanced_finance:financial_analysis_compare_financials",
    "mcp_enhanced_finance:risk_assessment_assess_risk",
    "mcp_enhanced_finance:finish"
  ],

  "seed_description": "研究主题或问题",

  "sampling_tips": [
    "使用 web_search 获取最新行业新闻和市场动态",
    "使用 knowledge_search 查询研报和公告等历史资料",
    "使用 market_data:get_quote 获取精确的股票实时行情（推荐）",
    "使用 market_data:get_history 获取历史K线数据进行趋势分析",
    "使用 financial_analysis:get_financial_report 获取详细财务报表",
    "使用 financial_analysis:calculate_financial_ratios 计算ROE、ROA等关键指标",
    "使用 risk_assessment:assess_risk 评估投资风险",
    "使用 bidding_search 搜索招投标信息了解市场机会",
    "使用 text2sql 查询结构化财务数据",
    "使用 data_analyzer 分析收集的数据提取洞察",
    "使用 chart_generator 生成可视化图表",
    "多轮搜索，逐步深入，直到信息充分",
    "结合网络搜索、行情数据、财务分析进行交叉验证",
    "关注数据的时效性和来源可靠性"
  ],

  "synthesis_tips": [
    "生成与金融研究相关的问题",
    "问题应该需要多工具协作才能回答",
    "推荐使用 MCP 专业工具获取精确数据",
    "答案要有具体数据支撑",
    "包含明确的分析结论和投资建议",
    "问题难度适中，需要3-6个工具调用"
  ],

  "qa_examples": [
    {
      "question": "分析贵州茅台(600519)的投资价值，包括当前股价、历史走势、财务状况和风险评估",
      "answer": "根据分析，贵州茅台当前股价为...，近期呈现...走势。财务方面，2024年Q3营收...，净利润...，ROE为...%。风险方面..."
    }
  ],

  "seeds_file": "seeds/finance_research/seeds.jsonl",
  "output_dir": "results/mcp_enhanced_finance"
}
