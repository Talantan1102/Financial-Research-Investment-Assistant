{
  "model_name": "openai/gpt-4o",
  "api_key": "${OPENROUTER_API_KEY}",
  "base_url": "https://openrouter.ai/api/v1",

  "max_depth": 15,
  "branching_factor": 3,
  "depth_threshold": 2,

  "min_depth": 3,
  "max_selected_traj": 3,
  "path_similarity_threshold": 0.7,

  "number_of_seed": null,

  "resource_types": ["finance_research_mcp_v2"],
  "resource_init_configs": {
    "finance_research_mcp_v2": {
      "content": {}
    }
  },

  "sandbox_server_url": "http://127.0.0.1:18890",
  "sandbox_auto_start": true,
  "sandbox_config_path": "configs/sandbox-server/finance_research_mcp_v2_config.json",
  "sandbox_timeout": 120,

  "available_tools": [
    "finance_research_mcp_v2:web_research_web_search",
    "finance_research_mcp_v2:web_research_knowledge_search",
    "finance_research_mcp_v2:web_research_deep_search",
    "finance_research_mcp_v2:market_data_get_quote",
    "finance_research_mcp_v2:market_data_search_stock",
    "finance_research_mcp_v2:market_data_get_history",
    "finance_research_mcp_v2:market_data_get_financial_data",
    "finance_research_mcp_v2:financial_analysis_get_financial_report",
    "finance_research_mcp_v2:financial_analysis_calculate_financial_ratios",
    "finance_research_mcp_v2:financial_analysis_compare_financials",
    "finance_research_mcp_v2:risk_assessment_assess_risk",
    "finance_research_mcp_v2:data_analysis_analyze_data",
    "finance_research_mcp_v2:data_analysis_generate_chart",
    "finance_research_mcp_v2:deep_research_research_plan"
  ],

  "seed_description": "金融研究主题或投资分析问题",

  "sampling_tips": [
    "使用 web_research_web_search 获取最新行业新闻和市场动态",
    "使用 web_research_knowledge_search 查询研报和公告等历史资料",
    "使用 market_data_get_quote 获取精确的股票实时行情",
    "使用 market_data_get_history 获取历史K线数据进行趋势分析",
    "使用 financial_analysis_get_financial_report 获取详细财务报表",
    "使用 financial_analysis_calculate_financial_ratios 计算ROE、ROA等关键指标",
    "使用 financial_analysis_compare_financials 对比同行业公司",
    "使用 risk_assessment_assess_risk 评估投资风险",
    "使用 data_analysis_analyze_data 分析收集的数据提取洞察",
    "使用 data_analysis_generate_chart 生成可视化图表",
    "使用 deep_research_research_plan 规划深度研究方案",
    "多轮搜索，逐步深入，直到信息充分",
    "结合网络搜索、行情数据、财务分析进行交叉验证",
    "关注数据的时效性和来源可靠性"
  ],

  "synthesis_tips": [
    "生成与金融研究相关的问题",
    "问题应该需要多工具协作才能回答",
    "推荐使用 MCP 专业工具获取精确数据",
    "答案要有具体数据支撑",
    "包含明确的分析结论和投资建议",
    "问题难度适中，需要3-6个工具调用"
  ],

  "seeds_file": "seeds/finance_research/seeds.jsonl",
  "output_dir": "results/finance_research_mcp_v2"
}
