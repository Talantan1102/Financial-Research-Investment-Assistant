{
  "server": {
    "url": "http://127.0.0.1:18890",
    "port": 18890,
    "session_ttl": 600
  },
  "resources": {
    "finance_research": {
      "enabled": true,
      "backend_class": "sandbox.server.backends.resources.finance_research.AgentFlowFinanceBackend",
      "description": "Finance Research Assistant Backend - 金融研投助手工具集",
      "config": {
        "search_api_key": "${SEARCH_API_KEY}",
        "llm_api_key": "${LLM_API_KEY}",
        "llm_base_url": "${LLM_BASE_URL:-https://api.openai.com/v1}",
        "db_connection_string": "${DB_CONNECTION_STRING}",
        "rag_kb_name": "${RAG_KB_NAME:-default}",
        "cache_ttl": 3600,
        "enable_cache": true
      }
    }
  },
  "warmup": {
    "enabled": true,
    "resources": ["finance_research"]
  }
}
