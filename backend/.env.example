# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=your-access-key-id
DOCMIND_ACCESS_KEY_SECRET=your-access-key-secret

# ==================== 搜索 API ====================
# 博查搜索 API（必填，当 BOCHA_MODE=real 时）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=your-bocha-api-key

# Bocha 搜索 API 模式 (v0.6+)
# - mock: 用 MockBochaService（LLM 生成的假搜索结果）— 测试 / 开发默认
# - real: 真打 Bocha API（需要 BOCHA_API_KEY）
BOCHA_MODE=mock
BOCHA_BASE_URL=https://api.bochaai.com/v1/web-search

# DEPRECATED v0.6: use BOCHA_MODE=mock|real instead
USE_MOCK_BOCHA=true

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# ==================== Tushare API ====================
# Tushare API Token（当 USE_MOCK_TUSHARE=false 时必填）
# 申请地址: https://tushare.pro/register
TUSHARE_API_TOKEN=your-tushare-token

# Tushare API URL（可选，默认 https://api.tushare.pro）
TUSHARE_API_URL=https://api.tushare.pro

# 是否使用 Mock Tushare 服务（默认 false，设置为 true 时使用 LLM 生成模拟数据）
USE_MOCK_TUSHARE=false

# Mock Tushare 服务使用的模型（可选，默认 deepseek-v4-flash）
MOCK_TUSHARE_MODEL=deepseek-v4-flash

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=your-juhe-stock-api-key

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=your-bid-app-key
BID_APP_SECRET=your-bid-app-secret
BID_APP_CODE=your-bid-app-code

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== Eval Cost Guardrail (Plan D) ====================
# Cumulative LLM spend cap for eval / nightly. Default 20.0 if unset.
# LLMService.chat raises BudgetExceeded when cumulative cost > this value.
EVAL_COST_LIMIT_CNY=20

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# ==================== v0.7 KB Search + Milvus + Embedding + PDF parser ====================
KB_MODE=mock                   # mock | real
EMBEDDING_MODE=qwen            # qwen | bge_local(bge_local 留 v0.9+)
PDF_PARSER_MODE=mineru         # mineru | pdfplumber
MINERU_MODEL_SOURCE=modelscope # ⚠️ 国内必需(Spike 1 实测,默认走 HuggingFace 国内访问失败)
# MINERU_MODEL_DIR=/path/to/.cache/mineru   # optional override; default ~/.cache/mineru/models/opendatalab/PDF-Extract-Kit-1___0/

# ==================== v0.8.3 — tushare 真接入 ====================
TUSHARE_MODE=mock                       # mock | real
# TUSHARE_TOKEN=                        # required when TUSHARE_MODE=real

# ==================== v0.8.3 — Email notifier ====================
EMAIL_MODE=mock                         # mock | real
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=                        # 授权码，不是邮箱密码
# SMTP_FROM=
MONITORING_ALERT_RECIPIENTS=           # 逗号分隔 email 列表，留空则不发邮件

# ==================== v0.8.3 — Monitoring engine ====================
MONITORING_DAILY_BUDGET_CNY=10
MONITORING_ESCALATION_PER_CALL_CAP_CNY=1
MONITORING_ESCALATION_MAX_CONCURRENT=1
MONITORING_DOGFOOD_CUSTOMERS=          # 实施时填，如 "600519.SH,000001.SZ,..."
# MONITORING_SCHEDULER_ENABLED=false   # 设为 true 启用 16:30+17:00 CST 定时扫描（生产环境）
