# Test environment — keep VITE_API_BASE empty so MSW handlers
# (registered with empty-base relative paths) match useChatSSE's
# `apiUrl()` output. Loading frontend/.env in vitest would set
# VITE_API_BASE=http://localhost:8000/ → MSW URL与 fetch URL 不匹配
# → 全套 useChatSSE test FAIL.
VITE_API_BASE=
VITE_API_PROXY=
